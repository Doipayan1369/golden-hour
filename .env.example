# ==============================================================================
# GOLDEN HOUR - ENVIRONMENT CONFIGURATION (SIH26184)
# ==============================================================================

# Application Environment
DATA_MODE=SIMULATION
DEFAULT_JURISDICTION="Gurugram North / Sector 14"

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# 1. Open your Supabase Dashboard -> Project Settings -> API (https://app.supabase.com)
# 2. Copy "Project URL" into SUPABASE_URL
# 3. Copy "anon public" or "service_role" API key into SUPABASE_KEY
# ------------------------------------------------------------------------------

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=
